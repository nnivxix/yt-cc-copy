{
  "name": "yt-cc-copy",
  "description": "Copy YouTube closed captions (CC) to clipboard",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:ff": "wxt -b firefox",
    "build": "wxt build",
    "build:ff": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:ff": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "serve": "live-server docs --port=5353"
  },
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "live-server": "^1.2.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "wxt": "^0.20.26"
  }
}
